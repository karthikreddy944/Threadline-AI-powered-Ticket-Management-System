# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://127.0.0.1:27017/ticket-system
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ticket-system
MONGO_URI=mongodb://127.0.0.1:27017/ticket-system

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# AI Engine (A.E.) — Gemini code analysis
# Get a key from https://aistudio.google.com/apikey
LLM_API_KEY=your_key_here
LLM_MODEL=gemini-3.6-flash

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
# 32-byte key as 64 hex characters
GITHUB_TOKEN_ENCRYPTION_KEY=
